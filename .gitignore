# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# anchor build artifacts
/anchor/.anchor/
/anchor/target/

# solana local validator
test-ledger/

# portfolio-wide meta-skills: operational/identity detail or grant-and-
# hackathon strategy framing not meant for a public repo a judge may browse
.claude/skills/teammate-commit-identity/
.claude/skills/claude-antigravity-setup/
.claude/skills/grants-track-record/
.claude/skills/hackathon-fit-check/
.claude/skills/portfolio-funding-rollup/

# skill-installer artifacts for other tools (mirrors of .claude/skills/,
# not content of this project) -- keeps the public repo to what's actually
# used here
.agents/
.aider-desk/
skills-lock.json

# local working notes, kept on disk and not tracked
AGENTS.md
docs/CHECKLIST-panel-review.md
docs/video-script.md
