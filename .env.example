# Devnet RPC. Swap for a Helius devnet endpoint before the live demo —
# priority fees on the public RPC aren't reliable under load.
SOLANA_RPC_URL=https://api.devnet.solana.com

ATTESTO_PROGRAM_ID=EgLkDDxhS1Cd61VjJzMSURC1zko3xtbcAexQqyGBqvdk
PROVA_PROGRAM_ID=G11dBAzLQaADtHHM2AZNz3ThCDnkY5nhX3Ujddu1CMM1

# Devnet USDC (SPL Token program, 6 decimals).
ATTESTO_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Associated token account (USDC, owned by the treasury keypair) that
# receives payment for every request. Not a per-client balance — see
# mexico-legal-check before changing this into anything that looks like one.
ATTESTO_TREASURY_ATA=9jFjRSwN7zchM83LDLHugcDmGKe3fJ7MKaZPZVb8VYvh

# Price per skill-check, in USDC base units (6 decimals). 10000 = $0.01.
ATTESTO_PRICE_ATOMIC=10000

# Signs record_fulfillment_attestation / file_dispute. Provide exactly one of:
ATTESTO_ISSUER_KEYPAIR_PATH=/path/to/attesto-issuer.json
# ATTESTO_ISSUER_SECRET_KEY=[1,2,3,...]   # JSON array, e.g. for Vercel

# Signs the resourceId tokens issued in 402 responses (HMAC-SHA256, 32+ random bytes).
ATTESTO_HMAC_SECRET=
